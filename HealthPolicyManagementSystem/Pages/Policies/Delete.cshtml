@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Policies.DeleteModel

@{
    ViewData["Title"] = "Delete Policy";
}

<h2>Delete Policy</h2>

<div class="alert alert-danger">

    <h5>Are you sure you want to delete this policy?</h5>

</div>

<form method="post">

    <input type="hidden" asp-for="Policy.PolicyID" />

    <div class="mb-3">
        <label class="form-label fw-bold">Title</label>
        <input class="form-control" value="@Model.Policy.Title" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Version</label>
        <input class="form-control" value="@Model.Policy.Version" readonly />
    </div>

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>