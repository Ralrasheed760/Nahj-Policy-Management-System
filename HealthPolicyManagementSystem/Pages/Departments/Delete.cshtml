@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Departments.DeleteModel

@{
    ViewData["Title"] = "Delete Department";
}

<h2>Delete Department</h2>

<h4>Are you sure you want to delete this department?</h4>

<hr />

<form method="post">

    <input type="hidden" asp-for="Department.DepartmentId" />

    <div class="mb-3">
        <label>Department Name</label>

        <input asp-for="Department.DepartmentName"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Description</label>

        <textarea asp-for="Department.Description"
                  class="form-control"
                  readonly></textarea>
    </div>

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
