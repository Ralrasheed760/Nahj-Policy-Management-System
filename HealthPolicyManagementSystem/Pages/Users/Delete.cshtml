@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Users.DeleteModel

@{
    ViewData["Title"] = "Delete User";
}

<h2>Delete User</h2>

<h4>Are you sure you want to deactivate this user?</h4>

<hr />

<form method="post">

    <input type="hidden" asp-for="AppUser.UserID" />

    <div class="mb-3">
        <label>Full Name</label>
        <input asp-for="AppUser.FullName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Username</label>
        <input asp-for="AppUser.Username" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="AppUser.Email" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-danger">
        Deactivate
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
