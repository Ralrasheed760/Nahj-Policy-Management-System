@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Users.EditModel

@{
    ViewData["Title"] = "Edit User";
}

<h2>Edit User</h2>

<form method="post">

    <input type="hidden" asp-for="AppUser.UserID" />

    <div class="mb-3">
        <label asp-for="AppUser.FullName"></label>
        <input asp-for="AppUser.FullName" class="form-control" />
        <span asp-validation-for="AppUser.FullName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AppUser.Username"></label>
        <input asp-for="AppUser.Username" class="form-control" />
        <span asp-validation-for="AppUser.Username"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AppUser.Password"></label>
        <input asp-for="AppUser.Password"
               type="password"
               class="form-control" />

        <small class="text-muted">
            Leave this field blank to keep the current password.
        </small>
    </div>

    <div class="mb-3">
        <label asp-for="AppUser.Email"></label>
        <input asp-for="AppUser.Email" class="form-control" />
        <span asp-validation-for="AppUser.Email"
              class="text-danger"></span>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-3">

            <label asp-for="AppUser.Role"></label>

            <select asp-for="AppUser.Role"
                    class="form-select"
                    id="AppUser_Role">

                <option value="Admin">Admin</option>
                <option value="SubAdmin">Sub Admin</option>
                <option value="Employee">Employee</option>

            </select>

            <span asp-validation-for="AppUser.Role"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="AppUser.BranchID">
                Branch
            </label>

            <select asp-for="AppUser.BranchID"
                    asp-items="Model.AppUser.Branches"
                    class="form-select">

                <option value="">Select Branch</option>

            </select>

            <span asp-validation-for="AppUser.BranchID"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="AppUser.DepartmentID">
                Department
            </label>

            <select asp-for="AppUser.DepartmentID"
                    asp-items="Model.AppUser.Departments"
                    class="form-select">

                <option value="">Select Department</option>

            </select>

            <span asp-validation-for="AppUser.DepartmentID"
                  class="text-danger"></span>

        </div>
    }
    else
    {
        <input type="hidden" asp-for="AppUser.Role" />
        <input type="hidden" asp-for="AppUser.BranchID" />
        <input type="hidden" asp-for="AppUser.DepartmentID" />

        <div class="alert alert-info">
            This employee belongs to your department.
        </div>
    }

    <div class="form-check mb-3">

        <input asp-for="AppUser.IsActive"
               class="form-check-input" />

        <label asp-for="AppUser.IsActive"
               class="form-check-label">
        </label>

    </div>

    <button type="submit"
            class="btn btn-success">
        Update
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}