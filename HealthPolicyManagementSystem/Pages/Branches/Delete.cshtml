@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Branches.DeleteModel

@{
    ViewData["Title"] = "Delete Branch";
}

<h2>Delete Branch</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this branch?
</div>

<table class="table">

    <tr>
        <th>Branch Name</th>
        <td>@Model.Branch.BranchName</td>
    </tr>

    <tr>
        <th>Branch Type</th>
        <td>@Model.Branch.BranchType</td>
    </tr>

</table>

<form method="post">

    <input type="hidden" asp-for="Branch.BranchID" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>