@page
@model HealthPolicyManagementSystem.Pages.Branches.CreateModel

@{
    ViewData["Title"] = "Add Branch";
}

<h2>Add Branch</h2>

<form method="post">

    <div class="mb-3">
        <label asp-for="Branch.BranchName"></label>
        <input asp-for="Branch.BranchName" class="form-control" />
        <span asp-validation-for="Branch.BranchName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Branch.BranchType"></label>
        <select asp-for="Branch.BranchType" class="form-control">
            <option value="">Select Type</option>
            <option>Hospital</option>
            <option>Primary Health Center</option>
            <option>Medical Complex</option>
            <option>Administration</option>
            <option>Specialized Center</option>
        </select>
        <span asp-validation-for="Branch.BranchType" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Branch.IsActive" class="form-check-input" />
        <label asp-for="Branch.IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}