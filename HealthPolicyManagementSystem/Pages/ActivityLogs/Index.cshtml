@page
@model HealthPolicyManagementSystem.Pages.ActivityLogs.IndexModel

@{
    ViewData["Title"] = "Activity Logs";
}

<div class="container mt-4">

    <h2 class="mb-4">Activity Logs</h2>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Action</th>
                        <th>Date & Time</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.ActivityLogs.Any())
                    {
                        @foreach (var item in Model.ActivityLogs)
                        {
                            <tr>

                                <td>
                                    @(Model.Users.TryGetValue(
                                        item.UserID,
                                        out var fullName)
                                        ? fullName
                                        : "Unknown User")
                                </td>

                                <td>
                                    @item.Action
                                </td>

                                <td>
                                    @item.ActionDate.ToString(
                                        "yyyy-MM-dd HH:mm:ss")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center text-muted py-4">
                                No activity logs found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>