@page
@model HealthPolicyManagementSystem.Pages.Notifications.IndexModel

@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>

@if (Model.IsAdmin || Model.IsSubAdmin)
{
    <p>
        <a asp-page="Create" class="btn btn-primary">
            Send Notification
        </a>
    </p>
}

<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>User</th>
            <th>Title</th>
            <th>Message</th>
            <th>Status</th>
            <th>Created At</th>

            @if (Model.IsAdmin || Model.IsSubAdmin)
            {
                <th>Actions</th>
            }

        </tr>

    </thead>

    <tbody>

        @if (Model.Notifications.Any())
        {
            @foreach (var item in Model.Notifications)
            {
                <tr>

                    <td>
                        @(Model.Users.ContainsKey(item.UserID)
                            ? Model.Users[item.UserID]
                            : "Unknown")
                    </td>

                    <td>@item.Title</td>

                    <td>@item.Message</td>

                    <td>
                        @(item.IsRead ? "Read" : "Unread")
                    </td>

                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                    @if (Model.IsAdmin || Model.IsSubAdmin)
                    {
                        <td>

                            <a asp-page="Delete"
                               asp-route-id="@item.NotificationID"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>

                        </td>
                    }

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No notifications found.
                </td>
            </tr>
        }

    </tbody>

</table>