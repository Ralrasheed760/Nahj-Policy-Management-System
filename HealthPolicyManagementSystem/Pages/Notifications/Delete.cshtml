@page "{id:int}"
@model HealthPolicyManagementSystem.Pages.Notifications.DeleteModel

@{
    ViewData["Title"] = "Delete Notification";
}

<h2>Delete Notification</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this notification?
</div>

<hr />

<div class="mb-3">
    <label class="form-label fw-bold">Title</label>
    <input class="form-control"
           value="@Model.Notification.Title"
           readonly />
</div>

<div class="mb-3">
    <label class="form-label fw-bold">Message</label>
    <textarea class="form-control"
              rows="4"
              readonly>@Model.Notification.Message</textarea>
</div>

<div class="mb-3">
    <label class="form-label fw-bold">Created At</label>
    <input class="form-control"
           value="@Model.Notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")"
           readonly />
</div>

<form method="post">

    <input type="hidden"
           asp-for="Notification.NotificationID" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>